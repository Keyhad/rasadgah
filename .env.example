# Copy to .env and adjust. Every variable is optional; defaults are shown.
# Reference: docs/07-reference/configuration.md

# Public hostname served by Caddy. Use a real domain in production to get a Let's Encrypt certificate.
SITE_ADDRESS=localhost
HTTP_PORT=80
HTTPS_PORT=443

# Application limits
TOKENS_PER_HOUR=30
MAX_UPLOAD_BYTES=262144

# Image used by the app service (set by the deploy job in CI)
APP_IMAGE=rasadgah
APP_TAG=local
